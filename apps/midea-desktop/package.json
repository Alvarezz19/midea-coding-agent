{
  "name": "@midea/desktop",
  "productName": "Midea Agent",
  "private": true,
  "version": "0.1.0",
  "description": "Midea vertical-domain desktop client for Hermes Agent.",
  "author": "Midea Agent Team",
  "type": "module",
  "main": "dist/electron-main.cjs",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5184",
    "dev:electron": "wait-on http://127.0.0.1:5184 && npm run build:electron && cross-env MIDEA_DESKTOP_DEV_SERVER=http://127.0.0.1:5184 node scripts/run-electron.mjs",
    "build:electron": "node scripts/bundle-electron.mjs",
    "build": "vite build && npm run build:electron",
    "start": "npm run build && node scripts/run-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint src/ electron/",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "builder": "node scripts/run-builder.mjs",
    "pack": "npm run build && npm run builder -- --dir",
    "dist:win": "npm run build && npm run builder -- --win nsis"
  },
  "dependencies": {
    "@hermes/shared": "file:../shared",
    "@nanostores/react": "1.1.0",
    "@tabler/icons-react": "3.44.0",
    "nanostores": "1.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "electron": "40.10.2",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "wait-on": "9.0.10"
  },
  "build": {
    "appId": "com.midea.agent.desktop",
    "productName": "Midea Agent",
    "artifactName": "Midea-Agent-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Midea Agent"
    }
  }
}
